# 환경 변수 · 비밀키 (docs/06 §5 — 키는 각자 로컬 .env, 커밋 금지)
.env
.env.*

# DB · 외부 API 캐시 (스냅샷 fixtures는 커밋한다 — docs/03 §7)
*.db
backend/data/cache/

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/
.next/
out/

# OS · 에디터
.DS_Store
.claude/settings.local.json   # 개인 로컬 설정 — launch.json은 커밋(팀 공유 실행 설정)
~$*          # Word/Excel 임시 잠금 파일 (docx 검수 중 생김)
